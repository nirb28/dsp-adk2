# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Google ADK (Gemini) Configuration (use LLM_* values)
# LLM_API_KEY=your-google-api-key
# LLM_MODEL=gemini-2.5-flash

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8200

# Data Storage
DATA_DIR=./data
AGENTS_DIR=./data/agents
TOOLS_DIR=./data/tools
GRAPHS_DIR=./data/graphs

# Starburst Galaxy
# SB_HOST must be the Trino/Starburst SQL endpoint host, not the Galaxy browser URL.
# Example placeholder only:
SB_HOST=your-starburst-sql-endpoint-host
SB_PORT=443
SB_HTTP_SCHEME=https
SB_USER=your-starburst-user
SB_PASSWORD=
SB_ACCESS_TOKEN=
SB_CATALOG=your_catalog
SB_SCHEMA=your_schema
SB_SOURCE=dsp-adk2-ai-bi
SB_DEFAULT_LIMIT=200
SB_ALLOWED_CATALOGS=your_catalog
SB_ALLOWED_SCHEMAS=your_schema
SB_DENIED_COLUMNS=

# Superset integration
SUPERSET_INTEGRATION_MODE=auto
SUPERSET_REST_URL=http://localhost:8088
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_API_USERNAME=admin
SUPERSET_API_PASSWORD=admin
SUPERSET_API_TIMEOUT=120

# Superset MCP
SUPERSET_MCP_URL=http://localhost:8811/mcp
SUPERSET_MCP_TIMEOUT=120
SUPERSET_DATABASE_NAME=starburst
SUPERSET_MCP_GUEST_USERNAME=sb-agent

# Security (optional)
API_KEY=your-admin-api-key
JWT_SECRET=your-jwt-secret

# Logging
LOG_LEVEL=INFO
AUTO_APP_RELOAD=false
DEBUG_TRACE=false
SSL_VERIFY=true

# Langfuse (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
